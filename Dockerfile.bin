FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags="-s -w" -o /shopwell-cli .

FROM scratch

COPY --from=builder /shopwell-cli /shopwell-cli
ENTRYPOINT ["/shopwell-cli"]
CMD ["--help"]
